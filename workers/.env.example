# Convex deployment URL (.convex.cloud), not the .convex.site HTTP actions URL.
CONVEX_URL=
JMAC_PROVIDER_ID=
JMAC_PROVIDER_SECRET=

# Default heartbeat interval is 15 seconds.
JMAC_HEARTBEAT_INTERVAL_SECONDS=15
JMAC_REQUEST_TIMEOUT_SECONDS=10
# Additional retries for temporary transport failures (0 to 5).
JMAC_MAX_RETRIES=3

# Required only with --execute-jobs. Use the HTTP actions origin (.convex.site).
CONVEX_HTTP_URL=
# Convex model record ID corresponding to the worker's pinned SmolLM2-135M model.
JMAC_MODEL_ID=
# Persistent private results directory, writable by the worker.
JMAC_RESULTS_DIRECTORY=output/assignments

# Required only with --execute-jobs --commit-results (install the chain extra).
# Use a dedicated development signer controlling the frontend-registered wallet.
JMAC_RPC_URL=http://localhost:8545
JMAC_CHAIN_ID=31337
JMAC_CONTRACT_ADDRESS=
JMAC_WALLET_ADDRESS=
JMAC_WALLET_PRIVATE_KEY=
